{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@sudoku/contracts": [
        "../contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
