# 이 파일을 복사해 .env 를 만든다.
#   cp .env.example .env && docker compose up -d
#
# docker compose 와 서버가 **같은 값**을 본다. 자격증명이 적히는 곳은 여기 하나다 —
# docker-compose.yml 에는 기본값이 없고, 서버는 아래 조각으로 접속 URL 을 조립한다
# (packages/server/src/config.ts). `${...}` 보간을 쓰지 않으므로 어떤 로더로 읽어도 같다.
#
# 이 파일이 없으면 서버는 인프로세스 PGlite + 파일 상태로 돈다. 반대로 **만들어 두었다면
# 컨테이너도 함께 띄워야 한다** — 조각이 다 있으면 서버가 진짜 DB 로 붙는다.
# `pnpm test` 는 이 파일을 읽지 않는다(진입점이 main.ts 가 아니다) — 종전대로 PGlite.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=sudoku
POSTGRES_DB=sudoku
# 5432/6379 가 아닌 이유는 같은 머신에서 도는 다른 스택과 부딪히지 않게 하려는 것이다
POSTGRES_PORT=5433
# POSTGRES_HOST=127.0.0.1     # 생략하면 127.0.0.1

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6380
# REDIS_HOST=127.0.0.1

# ── 관리형 DB 에 붙일 때 ────────────────────────────────────────────────────
# 대개 URL 하나만 주므로, 아래를 채우면 위 조각 대신 그것이 쓰인다.
# DATABASE_URL=postgres://user:pass@host:5432/db
# REDIS_URL=rediss://host:6379
