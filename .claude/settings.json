{
  "$comment": "NERV 연동 — 훅(세션·도구·서브에이전트 텔레메트리)과 statusline. 비밀 값은 없다(settings.local.json 이 갖는다). 훅과 statusline 은 nerv 저장소의 플러그인 스크립트를 절대 경로로 부르고, .claude/skills 와 .claude/agents 는 그 플러그인의 사본이다 — 원본이 바뀌었을 때 다시 맞추는 절차는 nerv/codebase/plugin/README.md 의 \"마켓플레이스 없이 쓰는 저장소\" 절.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward session",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-outbox flush",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward tool",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward subagent",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward subagent",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward stop",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward session-end",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Volumes/project/private/nerv/codebase/plugin/statusline/nerv-statusline.sh"
  }
}
