{
  "$comment": "NERV 연동 — 훅(세션·도구·서브에이전트 텔레메트리)과 statusline. 비밀 값은 없다(settings.local.json 이 갖는다).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward session",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-outbox flush",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward tool",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward subagent",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward subagent",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward stop",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Volumes/project/private/nerv/codebase/plugin/bin/nerv-hook-forward session-end",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Volumes/project/private/nerv/codebase/plugin/statusline/nerv-statusline.sh"
  }
}
